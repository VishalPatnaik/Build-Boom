// Extensive canvas rendering for completely unique cosmetic artwork.
export function renderBlock(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, id: string, isCenter: boolean, time: number) {
  const themeIdx = parseInt(id.replace('skin-', '')) || 0;
  ctx.save();
  ctx.translate(x + w / 2, y + h / 2);
  
  // Animation variables
  const bounce = Math.sin(time / 200) * 4;
  const slowWobble = Math.sin(time / 500) * 0.1;
  const fastFlutter = Math.sin(time / 50) * 0.2;
  const squash = 1 + Math.sin(time / 150) * 0.1;
  
  switch(themeIdx) {
    case 0: // Meadow: Flying Bee
      ctx.translate(0, bounce);
      ctx.scale(1/squash, squash);
      ctx.rotate(slowWobble);
      // Body
      ctx.fillStyle = '#FFD700';
      ctx.beginPath(); ctx.ellipse(0, 0, w*0.4, h*0.3, 0, 0, Math.PI*2); ctx.fill();
      // Stripes
      ctx.fillStyle = '#000';
      ctx.fillRect(-w*0.1, -h*0.28, w*0.08, h*0.56);
      ctx.fillRect(w*0.1, -h*0.25, w*0.08, h*0.5);
      // Wings
      ctx.save();
      ctx.rotate(fastFlutter);
      ctx.fillStyle = 'rgba(255,255,255,0.8)';
      ctx.beginPath(); ctx.ellipse(-w*0.1, -h*0.3, w*0.3, h*0.15, -Math.PI/6, 0, Math.PI*2); ctx.fill();
      ctx.restore();
      // Eye
      ctx.fillStyle = '#FFF'; ctx.beginPath(); ctx.arc(w*0.25, -h*0.1, 4, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#000'; ctx.beginPath(); ctx.arc(w*0.27, -h*0.1, 2, 0, Math.PI*2); ctx.fill();
      break;

    case 1: // Moon: Moon Emoji
      ctx.translate(0, Math.sin(time/300)*3);
      ctx.fillStyle = '#F4F6F0';
      ctx.beginPath(); ctx.arc(0, 0, w*0.4, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#D3D3D3';
      ctx.beginPath(); ctx.arc(-w*0.1, -h*0.1, w*0.1, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(w*0.15, h*0.1, w*0.08, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(-w*0.15, h*0.15, w*0.05, 0, Math.PI*2); ctx.fill();
      // Face
      ctx.fillStyle = '#333';
      ctx.font = `${w*0.4}px Arial`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('🌝', 0, 0);
      break;
      
    case 2: // Mars: Flying Insect (Alien bug)
      ctx.translate(0, Math.sin(time/150)*5);
      ctx.rotate(Math.sin(time/200)*0.1);
      // Body
      ctx.fillStyle = '#FF4500';
      ctx.beginPath(); ctx.ellipse(0, 0, w*0.2, h*0.4, 0, 0, Math.PI*2); ctx.fill();
      // Eyes
      ctx.fillStyle = '#00FF00';
      ctx.beginPath(); ctx.arc(-w*0.1, -h*0.2, w*0.1, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(w*0.1, -h*0.2, w*0.1, 0, Math.PI*2); ctx.fill();
      // Wings
      ctx.save();
      ctx.rotate(fastFlutter*2);
      ctx.fillStyle = 'rgba(200,50,50,0.6)';
      ctx.beginPath(); ctx.ellipse(w*0.3, 0, w*0.2, h*0.1, 0, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(-w*0.3, 0, w*0.2, h*0.1, 0, 0, Math.PI*2); ctx.fill();
      ctx.restore();
      break;

    case 3: // Deep Space: UFO
      ctx.translate(0, bounce);
      ctx.rotate(slowWobble);
      // Glass dome
      ctx.fillStyle = 'rgba(150, 200, 255, 0.7)';
      ctx.beginPath(); ctx.arc(0, -h*0.1, w*0.25, Math.PI, 0); ctx.fill();
      // Alien inside
      ctx.fillStyle = '#32CD32';
      ctx.beginPath(); ctx.arc(0, -h*0.1, w*0.1, 0, Math.PI*2); ctx.fill();
      // Base
      ctx.fillStyle = '#808080';
      ctx.beginPath(); ctx.ellipse(0, h*0.1, w*0.45, h*0.15, 0, 0, Math.PI*2); ctx.fill();
      // Lights
      ctx.fillStyle = (Math.floor(time/200)%2===0) ? '#00FF00' : '#FF0000';
      ctx.beginPath(); ctx.arc(-w*0.3, h*0.1, 3, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(0, h*0.15, 3, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(w*0.3, h*0.1, 3, 0, Math.PI*2); ctx.fill();
      break;

    case 4: // Ocean: Jellyfish
      ctx.translate(0, -bounce);
      ctx.scale(squash, 1/squash);
      // Dome
      ctx.fillStyle = 'rgba(0, 191, 255, 0.8)';
      ctx.beginPath(); ctx.arc(0, -h*0.1, w*0.35, Math.PI, 0); ctx.fill();
      // Tentacles
      ctx.strokeStyle = 'rgba(0, 191, 255, 0.6)';
      ctx.lineWidth = 3;
      for(let i=-2; i<=2; i++) {
         ctx.beginPath();
         ctx.moveTo(i*w*0.1, -h*0.1);
         const wave = Math.sin(time/200 + i)*5;
         ctx.quadraticCurveTo(i*w*0.15 + wave, h*0.1, i*w*0.1 - wave, h*0.4);
         ctx.stroke();
      }
      break;

    case 5: // Beach: Rubber Duck
      ctx.translate(0, bounce*1.5);
      ctx.rotate(Math.sin(time/300)*0.15);
      ctx.fillStyle = '#FFD700';
      // Body
      ctx.beginPath(); ctx.ellipse(0, h*0.1, w*0.35, h*0.25, 0, 0, Math.PI*2); ctx.fill();
      // Head
      ctx.beginPath(); ctx.arc(w*0.2, -h*0.15, w*0.2, 0, Math.PI*2); ctx.fill();
      // Beak
      ctx.fillStyle = '#FF8C00';
      ctx.beginPath(); ctx.ellipse(w*0.4, -h*0.15, w*0.15, h*0.08, 0, 0, Math.PI*2); ctx.fill();
      // Eye
      ctx.fillStyle = '#000';
      ctx.beginPath(); ctx.arc(w*0.25, -h*0.2, 3, 0, Math.PI*2); ctx.fill();
      break;

    case 6: // Volcano: Lava Slime
      ctx.scale(squash*1.1, 1/(squash*1.1));
      ctx.fillStyle = '#FF4500';
      ctx.beginPath();
      ctx.moveTo(-w*0.4, h*0.4);
      ctx.quadraticCurveTo(0, -h*0.5 + Math.sin(time/100)*10, w*0.4, h*0.4);
      ctx.closePath();
      ctx.fill();
      // Eyes
      ctx.fillStyle = '#FFE4B5';
      ctx.beginPath(); ctx.arc(-w*0.15, h*0.1, w*0.08, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(w*0.15, h*0.1, w*0.08, 0, Math.PI*2); ctx.fill();
      break;

    // Provide rich fallbacks for the rest using highly styled text/emoji as a base but mixed with paths
    default:
      ctx.translate(0, bounce);
      ctx.scale(1/squash, squash);
      
      const emojis = [
        '','','','','','','',
        '🏮', // 7 Lunar Temple
        '🍄', // 8 Enchanted
        '🌵', // 9 Desert
        '🛡️', // 10 Castle
        '☁️', // 11 Sky Islands
        '🔋', // 12 Robot City
        '☕', // 13 Modern City
        '🧸', // 14 Candy
        '💾', // 15 Cyber
        '🐁', // 16 Toy
        '🦖', // 17 Prehistoric
        '🕊️', // 18 Sakura
        '🪙', // 19 Pirate
        '🧪', // 20 Lab
        '👁️', // 21 Haunted
        '🎈', // 22 Carnival
        '👑', // 23 Golden
      ];
      const emoji = emojis[themeIdx] || '📦';
      
      // Draw a subtle magical aura behind them
      const grad = ctx.createRadialGradient(0,0,0, 0,0,w*0.6);
      grad.addColorStop(0, 'rgba(255,255,255,0.4)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = grad;
      ctx.beginPath(); ctx.arc(0,0,w*0.6,0,Math.PI*2); ctx.fill();
      
      ctx.font = `${w*0.6}px Arial`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.filter = 'drop-shadow(0px 4px 4px rgba(0,0,0,0.5))';
      ctx.fillText(emoji, 0, 0);
      ctx.filter = 'none';
      break;
  }
  
  ctx.restore();
}

export function renderPlate(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, id: string, time: number) {
  const themeIdx = parseInt(id.replace('plate-', '')) || 0;
  ctx.save();
  ctx.translate(x + w / 2, y + h / 2);
  
  // Base plate logic
  switch(themeIdx) {
    case 5: // Beach Surfboard
      ctx.rotate(Math.sin(time/400)*0.05);
      ctx.fillStyle = '#FF4500';
      ctx.beginPath(); ctx.ellipse(0, 0, w*0.5, h*0.3, 0, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#FFF';
      ctx.fillRect(-w*0.4, -h*0.05, w*0.8, h*0.1);
      break;
    case 8: // Enchanted Tree Stump
      ctx.fillStyle = '#8B4513';
      ctx.beginPath(); ctx.ellipse(0, 0, w*0.45, h*0.4, 0, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#D2B48C';
      ctx.beginPath(); ctx.ellipse(0, -h*0.2, w*0.4, h*0.15, 0, 0, Math.PI*2); ctx.fill();
      // Glowing rings
      ctx.strokeStyle = '#32CD32';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.ellipse(0, -h*0.2, w*0.3, h*0.1, 0, 0, Math.PI*2); ctx.stroke();
      break;
    default:
      // A highly stylized platform
      const colors = ['#228B22', '#696969', '#B22222', '#4169E1', '#FF7F50', '#FFD700', '#1C1C1C', '#E6E6FA', '#2E8B57', '#EDC9AF', '#708090', '#FFFFFF', '#2F4F4F', '#808080', '#FF69B4', '#000000', '#FF0000', '#8B4513', '#FFC0CB', '#8B4513', '#E0FFFF', '#4B0082', '#E6E6FA', '#FFD700'];
      const color = colors[themeIdx] || '#FFF';
      
      ctx.fillStyle = color;
      ctx.beginPath(); ctx.roundRect(-w/2, -h/2, w, h, h/2); ctx.fill();
      // Top highlight
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.beginPath(); ctx.roundRect(-w/2 + 2, -h/2 + 2, w - 4, h/2 - 2, h/4); ctx.fill();
      // Bottom shadow
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.beginPath(); ctx.roundRect(-w/2 + 2, h/4, w - 4, h/4, h/4); ctx.fill();
      break;
  }
  
  ctx.restore();
}

export function renderBoomParticle(ctx: CanvasRenderingContext2D, p: any, time: number, id: string) {
  const themeIdx = parseInt(id.replace('boom-', '')) || 0;
  ctx.save();
  ctx.translate(p.x, p.y);
  ctx.rotate(p.rotation);
  ctx.globalAlpha = p.life;
  
  const scale = 1 + (1 - p.life) * 2;
  ctx.scale(scale, scale);
  
  switch(themeIdx) {
    case 1: // Black Hole
      ctx.fillStyle = '#000';
      ctx.beginPath(); ctx.arc(0, 0, p.size, 0, Math.PI*2); ctx.fill();
      ctx.strokeStyle = '#8A2BE2';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(0, 0, p.size * 1.5, 0, Math.PI*2); ctx.stroke();
      break;
    case 4: // Water Splash
      ctx.fillStyle = '#00BFFF';
      ctx.beginPath();
      ctx.moveTo(0, -p.size);
      ctx.quadraticCurveTo(p.size, p.size, 0, p.size*1.5);
      ctx.quadraticCurveTo(-p.size, p.size, 0, -p.size);
      ctx.fill();
      break;
    case 5: // Beach Ball Burst
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(0,0,p.size,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle = '#FFF'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(-p.size, 0); ctx.lineTo(p.size, 0); ctx.stroke();
      break;
    default:
      // Generic beautiful particle
      ctx.fillStyle = p.color;
      if (themeIdx % 2 === 0) {
        // Star shape
        ctx.beginPath();
        for(let i=0; i<5; i++) {
          ctx.lineTo(Math.cos((18+i*72)*Math.PI/180)*p.size, -Math.sin((18+i*72)*Math.PI/180)*p.size);
          ctx.lineTo(Math.cos((54+i*72)*Math.PI/180)*p.size*0.5, -Math.sin((54+i*72)*Math.PI/180)*p.size*0.5);
        }
        ctx.closePath();
        ctx.fill();
      } else {
        // Glowing orb
        const grad = ctx.createRadialGradient(0,0,0, 0,0,p.size);
        grad.addColorStop(0, '#FFF');
        grad.addColorStop(1, p.color);
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(0,0,p.size,0,Math.PI*2); ctx.fill();
      }
      break;
  }
  
  ctx.restore();
}

export function renderWorld(ctx: CanvasRenderingContext2D, w: number, h: number, id: string, time: number, isPreview: boolean = false) {
  const themeIdx = parseInt(id.replace('bg-', '')) || 0;
  
  // Background gradient
  const grad = ctx.createLinearGradient(0, 0, 0, h);
  const colors = [
    ['#87CEEB', '#E0F6FF'], // Meadow
    ['#0B0C10', '#191970'], // Moon
    ['#8B0000', '#FF4500'], // Mars
    ['#050510', '#1F2833'], // Space
    ['#001F3F', '#006994'], // Ocean
    ['#87CEFA', '#F0E68C'], // Beach
    ['#3B0918', '#FF4500'], // Volcano
    ['#190E2D', '#483D8B'], // Lunar Temple
    ['#1A2F22', '#2E8B57'], // Enchanted
    ['#CD853F', '#EDC9AF'], // Desert
    ['#2F4F4F', '#708090'], // Castle
    ['#4facfe', '#00f2fe'], // Sky
    ['#000000', '#2F4F4F'], // Robot
    ['#1C1C1C', '#808080'], // City
    ['#FF1493', '#FFB6C1'], // Candy
    ['#000000', '#003300'], // Cyber
    ['#FF0000', '#FFFF00'], // Toy
    ['#3E2723', '#556B2F'], // Prehistoric
    ['#FFB6C1', '#FFF0F5'], // Sakura
    ['#000000', '#8B4513'], // Pirate
    ['#4B0082', '#9370DB'], // Lab
    ['#000000', '#4B0082'], // Haunted
    ['#8A2BE2', '#FF69B4'], // Carnival
    ['#B8860B', '#FFD700'], // Golden
  ];
  
  const c = colors[themeIdx] || colors[0];
  grad.addColorStop(0, c[0]);
  grad.addColorStop(1, c[1]);
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, w, h);
  
  // Ambient Particles / Environment details
  ctx.save();
  const numParticles = isPreview ? 5 : 20;
  
  for(let i=0; i<numParticles; i++) {
     const py = (time * 0.02 * (1 + i%3) + i * 100) % (h + 50) - 25;
     const px = (i * (w/numParticles) + Math.sin(time/1000 + i)*20) % w;
     
     switch(themeIdx) {
       case 1: // Moon (Stars)
       case 3: // Space
         ctx.fillStyle = 'rgba(255,255,255,0.8)';
         ctx.beginPath(); ctx.arc(px, h - py, (i%3)+1, 0, Math.PI*2); ctx.fill();
         break;
       case 4: // Ocean (Bubbles)
         ctx.strokeStyle = 'rgba(255,255,255,0.4)';
         ctx.lineWidth = 2;
         ctx.beginPath(); ctx.arc(px, h - py, (i%5)+2, 0, Math.PI*2); ctx.stroke();
         break;
       case 8: // Enchanted (Fireflies)
         ctx.fillStyle = 'rgba(152, 251, 152, 0.8)';
         ctx.beginPath(); ctx.arc(px, py, 3, 0, Math.PI*2); ctx.fill();
         ctx.shadowColor = '#98FB98'; ctx.shadowBlur = 10;
         break;
       case 18: // Sakura (Petals)
         ctx.fillStyle = 'rgba(255, 182, 193, 0.8)';
         ctx.save();
         ctx.translate(px, py);
         ctx.rotate(time/500 + i);
         ctx.beginPath(); ctx.ellipse(0,0, 6, 3, 0, 0, Math.PI*2); ctx.fill();
         ctx.restore();
         break;
       default: // Subtle dust
         ctx.fillStyle = 'rgba(255,255,255,0.1)';
         ctx.beginPath(); ctx.arc(px, py, 2, 0, Math.PI*2); ctx.fill();
         break;
     }
  }
  ctx.restore();
}

export function getBoomColor(id: string) { return '#FFFFFF'; }
