# Copy to .env for local runs. On a host, set these as environment variables instead.

# Stripe secret key. Required for real purchases in production; without it,
# checkout returns "Payments are not configured" (no simulated purchases in production).
STRIPE_SECRET_KEY="sk_live_or_sk_test_..."

# Port the server listens on. Most hosts (Cloud Run, Render, Railway) set this for you.
PORT=3000

# Set to "production" when serving the built game (npm run build && npm start).
NODE_ENV=production
