# Copy to .env for local runs. On a host, set these as environment variables instead.
# This server is only the online API (tournaments, leaderboards) for the Android app.
# Purchases go through Google Play Billing inside the app, so no payment keys live here.

# Port the server listens on. Most hosts (Cloud Run, Render, Railway) set this for you.
PORT=3000

# "production" = API only. Leave unset locally to also serve the game for desktop testing.
NODE_ENV=production
