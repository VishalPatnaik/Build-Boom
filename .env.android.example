# Copy to .env.android before running `npm run build:android`.

# Your deployed game server (tournaments and leaderboards). Leave empty to ship
# offline-only; the game then uses its built-in sample tournaments.
VITE_API_BASE_URL=https://play.vesyron.com

# AdMob ad unit IDs from https://apps.admob.com (Apps > TOWER//SHIFT > Ad units).
# Leave empty to use Google's test ads.
VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
